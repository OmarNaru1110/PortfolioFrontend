---
import AboutView from './views/AboutView.astro';
import ExperienceView from './views/ExperienceView.astro';
import ProjectView from './views/ProjectView.astro';
import WritingView from './views/WritingView.astro';
import { experienceItems, projectItems, writingItems } from '../data/content';
---

<section class="lg:col-span-7 min-h-[460px] lg:pl-10 xl:pl-16 lg:border-l lg:border-zinc-200/80 hidden lg:block sticky top-5 lg:top-20">
  <div class="detail-view-stage w-full">
    <AboutView />

    <!-- Experience -->
    {experienceItems.map(item => (
      <ExperienceView
        id={item.id}
        role={item.role}
        company={item.company}
        period={item.period}
        location={item.location}
        description={item.description}
      />
    ))}

    <!-- Projects -->
    {projectItems.map(item => (
      <ProjectView
        id={item.id}
        title={item.title}
        subtitle={item.subtitle}
        description={item.description}
        tags={item.tags}
        codeHref={item.codeHref}
        demoHref={item.demoHref}
      />
    ))}

    <!-- Writing -->
    {writingItems.map(item => (
      <WritingView
        id={item.id}
        title={item.title}
        year={item.date}
        description={item.description}
        url={item.url}
      />
    ))}
  </div>
</section>