---
interface Props {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  tags: string[];
  codeHref?: string;
  demoHref?: string;
}

const { id, title, subtitle, description, tags, codeHref, demoHref } = Astro.props;
---

<article class="detail-view hidden-state" id={`view-${id}`}>
  <div class="max-w-xl space-y-5">
    <header>
      <h3 class="text-3xl font-semibold tracking-tight text-zinc-950 leading-snug">{title}</h3>
      <div class="text-xs text-zinc-600 font-mono mt-1">{subtitle}</div>
    </header>
    <p class="text-base text-zinc-700 leading-[1.65]">{description}</p>
    <div class="pt-3 flex flex-wrap gap-2 text-xs font-mono text-zinc-700">
      {tags.map(tag => (
        <span class="px-2.5 py-1 border border-zinc-300/80 bg-white/40 rounded-full">{tag}</span>
      ))}
    </div>
    <div class="border-t border-zinc-200/80 pt-4 flex flex-wrap gap-x-5 gap-y-2">
      {codeHref && (
        <a class="inline-flex items-center text-sm font-medium text-[#0f172a] underline underline-offset-4 decoration-1 decoration-zinc-300 hover:decoration-zinc-950 transition-colors" href={codeHref} rel="noopener noreferrer" target="_blank">
          Code →
        </a>
      )}
      {demoHref && (
        <a class="inline-flex items-center text-sm font-medium text-[#0f172a] underline underline-offset-4 decoration-1 decoration-zinc-300 hover:decoration-zinc-950 transition-colors" href={demoHref} rel="noopener noreferrer" target="_blank">
          Demo →
        </a>
      )}
    </div>
  </div>
</article>
