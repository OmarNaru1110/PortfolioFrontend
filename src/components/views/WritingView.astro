---
interface Props {
  id: string;
  title: string;
  year: string;
  description: string;
  url: string;
}

const { id, title, year, description, url } = Astro.props;
---

<article class="detail-view hidden-state" id={`view-${id}`}>
  <div class="max-w-xl space-y-5">
    <header>
      <h3 class="text-3xl font-semibold tracking-tight text-zinc-950 leading-snug">{title}</h3>
      <div class="text-xs text-zinc-600 font-mono mt-1">{year}</div>
    </header>
    <p class="text-base text-zinc-700 leading-[1.65]">{description}</p>
    <div class="border-t border-zinc-200/80 pt-4">
      <a class="inline-flex items-center text-sm font-medium text-[#0f172a] underline underline-offset-4 decoration-1 decoration-zinc-300 hover:decoration-zinc-950 transition-colors" href={url} rel="noopener noreferrer" target="_blank">
        Read on LinkedIn →
      </a>
    </div>
  </div>
</article>
